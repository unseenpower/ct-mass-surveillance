#!/usr/bin/env bash
#
# Refuse to create a commit under an identity that is not this project's
# pseudonym.
#
# This repository is public. A wrong author line cannot be corrected after a
# push without rewriting history, so the check has to happen before the commit
# object exists -- which is what this hook is for.
#
# A clone does not inherit hooks any more than it inherits local config, so
# enable it once per checkout:
#
#     git config core.hooksPath .githooks
#
# CI re-checks pushed commits regardless, in case that was never done.
#
set -euo pipefail

EXPECTED_NAME='Shoot the Singer (1 Sick Verse)'
EXPECTED_EMAIL='unseenpower@users.noreply.github.com'

# Read the identity git has actually resolved for this commit rather than
# reading user.name/user.email directly: that way GIT_AUTHOR_NAME and
# GIT_AUTHOR_EMAIL in the environment are caught too, and those are exactly
# how an automated caller overrides the config.
ident=$(git var GIT_AUTHOR_IDENT)
name=${ident%% <*}
email=${ident#*<}
email=${email%%>*}

if [ "$name" = "$EXPECTED_NAME" ] && [ "$email" = "$EXPECTED_EMAIL" ]; then
  exit 0
fi

cat >&2 <<MSG

pre-commit: refusing to commit under a non-pseudonymous identity.

  this commit would be authored as:  ${name} <${email}>
  it must be authored as:            ${EXPECTED_NAME} <${EXPECTED_EMAIL}>

This repository is public and commit attribution is permanent. Set the
identity for this checkout, then commit again:

    git config --local user.name  "${EXPECTED_NAME}"
    git config --local user.email "${EXPECTED_EMAIL}"

If you are certain you want the identity above in public history, bypass with
--no-verify. There is no way to take it back afterwards.
MSG
exit 1
